GOOGLE_API_KEY=your_google_api_key_here

# Optional: Service account JSON key file.
# Use a relative path (resolved from backend/ working directory) so the same .env
# works on both dev and Raspberry Pi.
# Example: put the key at backend/sa-key.json and set:
# SERVICE_ACCOUNT_FILE=sa-key.json
# SERVICE_ACCOUNT_FILE=

# Comma-separated list of calendar IDs to display
CALENDAR_IDS=en.norwegian#holiday@group.v.calendar.google.com
MET_NO_LAT=59.9139
MET_NO_LON=10.7522
MET_NO_USER_AGENT=rpi-calendar/1.0 contact@example.com
DB_PATH=/var/lib/rpi-calendar/rpi-calendar.db
