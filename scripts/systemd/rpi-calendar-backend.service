[Unit]
Description=RPi Calendar FastAPI Backend
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/rpi-calendar/backend
Environment="PATH=/home/pi/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=uv run gunicorn -w 2 -k uvicorn.workers.UvicornWorker -b 0.0.0.0:5000 app:app
Restart=always
RestartSec=5
EnvironmentFile=-/home/pi/rpi-calendar/backend/.env

[Install]
WantedBy=multi-user.target
